generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  MERCADO_PAGO
  TRANSFERENCIA
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum DraftStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ArgentinaProvince {
  BUENOS_AIRES
  CABA
  CATAMARCA
  CHACO
  CHUBUT
  CORDOBA
  CORRIENTES
  ENTRE_RIOS
  FORMOSA
  JUJUY
  LA_PAMPA
  LA_RIOJA
  MENDOZA
  MISIONES
  NEUQUEN
  RIO_NEGRO
  SALTA
  SAN_JUAN
  SAN_LUIS
  SANTA_CRUZ
  SANTA_FE
  SANTIAGO_DEL_ESTERO
  TIERRA_DEL_FUEGO
  TUCUMAN
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  weightKg    Decimal  @db.Decimal(8, 3)
  enabled     Boolean  @default(true)

  freeShipping          Boolean             @default(false)
  freeShippingProvinces ArgentinaProvince[]  @default([])

  images     ProductImage[]
  sections   ProductSection[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  url       String
  position  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Section {
  id       String           @id @default(cuid())
  name     String
  slug     String           @unique
  products ProductSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductSection {
  productId String
  sectionId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
}

model Order {
  id            String            @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  postalCode    String
  province      ArgentinaProvince

  items OrderItem[]

  paymentMethod PaymentMethod
  shippingCost  Decimal       @db.Decimal(12, 2)
  itemsSubtotal Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        OrderStatus   @default(PENDIENTE)

  mpPreferenceId String?
  mpPaymentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  titleSnapshot    String
  priceSnapshot    Decimal @db.Decimal(12, 2)
  quantity         Int
  weightKgSnapshot Decimal @db.Decimal(8, 3)

  @@index([orderId])
}

model ShippingProvinceConfig {
  id        String            @id @default(cuid())
  province  ArgentinaProvince @unique
  basePrice Decimal           @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt
}

model ShippingSurchargeRule {
  id           String  @id @default(cuid())
  thresholdKg  Decimal @db.Decimal(8, 3)
  surchargePct Decimal @db.Decimal(5, 2)
  active       Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model CheckoutDraft {
  id             String      @id @default(cuid())
  payload        Json
  mpPreferenceId String?     @unique
  status         DraftStatus @default(PENDING)
  orderId        String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
